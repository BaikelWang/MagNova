# MiniMind requirement parser (OpenAI-compatible)
MINIMIND_API_URL=http://127.0.0.1:8504/v1/chat/completions
MINIMIND_TASK_API_URL=http://127.0.0.1:8506/v1/chat/completions

# Evidence-grounded research assistant
MINIMIND_RESEARCH_API_URL=http://127.0.0.1:8512/v1/chat/completions
BGE_API_URL=http://127.0.0.1:8508/v1/embeddings
MAGNOVA_RAG_CORPUS=rag-corpus-v5
MAGNOVA_RAG_THRESHOLD=0.0

# Scientific workflow backend: mock | http | cli
MAGNOVA_BACKEND_MODE=mock
# MAGNOVA_BACKEND_URL=http://127.0.0.1:9000
# MAGNOVA_BACKEND_API_KEY=
# MAGNOVA_SACGT_CLI=/path/to/run_magnova_request.py
# SACGT_PYTHON=/path/to/python
# MAGNOVA_SACGT_WORKDIR=/path/to/private/backend
# MAGNOVA_OUTPUT_ROOT=/path/to/results
# MAGNOVA_DEMO_ARTIFACTS=/path/to/read-only/demo/artifacts

MAGNOVA_TASK_DB=runtime/agent_tasks.sqlite3
MAGNOVA_REQUEST_TIMEOUT=30
MAGNOVA_JOB_TIMEOUT=300
MAGNOVA_POLL_INTERVAL=1
MAGNOVA_MAX_POLL_INTERVAL=10
