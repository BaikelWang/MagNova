# Optional MiniMind OpenAI-compatible inference endpoint
MINIMIND_API_URL=http://127.0.0.1:8504/v1/chat/completions

# Optional real MagNova workflow service. Leave unset to use the mock pipeline.
# MAGNOVA_BASE_URL=http://127.0.0.1:9000
# MAGNOVA_API_KEY=

MAGNOVA_TASK_DB=runtime/agent_tasks.sqlite3
MAGNOVA_REQUEST_TIMEOUT=30
MAGNOVA_JOB_TIMEOUT=300
MAGNOVA_POLL_INTERVAL=1
MAGNOVA_MAX_POLL_INTERVAL=10
